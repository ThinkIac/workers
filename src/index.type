provideWorkers = (host) ->

  ###*
  # @register module workers
  # @context capability
  ###

  pool = null
  {
    name: 'workers'
    phase: 'boot'
    swappable: false
    api: getPool: ->
      pool
    install: ->
      if `host.config().workers != false`
        pool = new CpuWorkerPool(host.config().workers)
      host.state('runtime').set 'workers', pool
      return
    close: ->
      (if `pool == null` or `pool == void 0` then undefined else pool.close())

  }

